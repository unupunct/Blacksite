<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Blacksite.Linux</RootNamespace>
    <AssemblyName>blacksite</AssemblyName>
    <Version>1.0.0</Version>
    <Product>BLACKSITE</Product>
    <Description>BLACKSITE – Tactical Interface Simulator (Linux)</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Blacksite.UI\Blacksite.UI.csproj" />
  </ItemGroup>
</Project>
